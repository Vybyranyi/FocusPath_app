{
  // У монорепо два окремі ESLint-конфіги (frontend/eslint.config.js і
  // server/eslint.config.mjs). Без цього списку розширення шукає конфіг від
  // кореня, не знаходить його і мовчки не підсвічує нічого.
  "eslint.workingDirectories": [
    { "directory": "frontend", "changeProcessCWD": true },
    { "directory": "server", "changeProcessCWD": true }
  ],
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact"],

  // Prettier у проєкті немає. Вбудований форматер VS Code переформатував би
  // увесь наявний код і перетворив будь-який PR на нечитабельний diff.
  // Відступи натомість тримає .editorconfig, а стиль коду — ESLint.
  "editor.formatOnSave": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,

  // Версія TypeScript із проєкту, а не та, що вшита у VS Code: інакше
  // erasableSyntaxOnly та інші нові прапорці в tsconfig можуть не розпізнатися.
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "non-relative",

  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/coverage": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/coverage/**": true
  },

  "[markdown]": {
    "editor.wordWrap": "on"
  }
}
