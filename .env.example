# Server
NODE_ENV=development
PORT=3000
MONGO_URI=
OPENAI_API_KEY=

# Signing keys. Separate keys per token kind contain the blast radius if one
# leaks; outside production both fall back to JWT_SECRET with a warning.
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Session cookies. "lax" is right when the app and API share a site, which is
# the case locally. Split them across domains and this must be "none" — at
# which point the CSRF token stops being a second line and becomes the first.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Comma-separated list of browser origins allowed to call the API.
# Defaults to Vite's dev server when unset.
CORS_ORIGIN="http://localhost:5173"

# bcrypt work factor. Higher is slower and stronger; 12 is the default.
BCRYPT_ROUNDS=12

# Frontend. In development the API is a separate origin; in the Docker image
# Express serves both halves, so this is empty there and every request goes out
# as a relative path.
VITE_API_URL="http://localhost:3000"

# Admin seed (used by server/src/scripts/seedAdmin.ts)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Tests need no database URI: the server test suite spins up an in-memory
# MongoDB per run (mongodb-memory-server) and sets its own NODE_ENV/JWT_SECRET
# in server/jest.env.ts.
